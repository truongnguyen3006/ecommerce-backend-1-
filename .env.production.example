# Safe placeholders. Values marked REPLACE are required, never deploy this file unchanged.
COMPOSE_PROJECT_NAME=project1-prod
IMAGE_NAMESPACE=ghcr.io/REPLACE_WITH_LOWERCASE_OWNER
IMAGE_TAG=REPLACE_WITH_IMMUTABLE_RELEASE
FRONTEND_SOURCE=../frontend
PUBLIC_APP_HOST=shop.example.invalid
PUBLIC_AUTH_HOST=auth.example.invalid
PUBLIC_FRONTEND_URL=https://shop.example.invalid
NEXT_PUBLIC_WS_URL=https://shop.example.invalid/ws
KEYCLOAK_HOSTNAME=https://auth.example.invalid
KEYCLOAK_ISSUER_URI=https://auth.example.invalid/realms/spring-boot-microservices-realm
KEYCLOAK_REALM=spring-boot-microservices-realm
KEYCLOAK_CLIENT_ID=spring-cloud-client
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_64_HEX_CHARS
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_OPERATOR_USERNAME
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARS
KEYCLOAK_DB_ROOT_PASSWORD=REPLACE_WITH_64_HEX_CHARS
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_64_HEX_CHARS
PRODUCT_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
PRODUCT_DB_MIGRATION_PASSWORD=REPLACE_WITH_64_HEX_CHARS
ORDER_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
ORDER_DB_MIGRATION_PASSWORD=REPLACE_WITH_64_HEX_CHARS
PAYMENT_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
PAYMENT_DB_MIGRATION_PASSWORD=REPLACE_WITH_64_HEX_CHARS
USER_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
USER_DB_MIGRATION_PASSWORD=REPLACE_WITH_64_HEX_CHARS
CART_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
CART_DB_MIGRATION_PASSWORD=REPLACE_WITH_64_HEX_CHARS
EUREKA_USERNAME=service_registry
EUREKA_PASSWORD=REPLACE_WITH_64_HEX_CHARS
REDIS_PASSWORD=REPLACE_WITH_64_HEX_CHARS
# Generate once: Kafka kafka-storage random-uuid. NEVER change against existing data.
KAFKA_CLUSTER_ID=REPLACE_WITH_22_CHARACTER_CLUSTER_ID
GRAFANA_ADMIN_USERNAME=REPLACE_WITH_OPERATOR_USERNAME
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARS
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://shop.example.invalid/api/payment/vnpay/return
VNPAY_IPN_URL=https://shop.example.invalid/api/payment/vnpay/ipn
TRACING_SAMPLE_RATE=0.1
# Kafka/Registry are PLAINTEXT on the private Docker data network in this profile.
# Managed Kafka SASL/TLS requires compatible producer/consumer/Streams/probe configuration
# and a separately reviewed override; these empty values do NOT activate it.
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# GitHub Actions GHCR uses GITHUB_TOKEN; private pulls use an operator read:packages token.
