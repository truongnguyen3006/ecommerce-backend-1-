# External integrations
# Spring Boot does not automatically load this file.
# Set these values as OS/IDE/Docker environment variables before starting the relevant service.

# Cloudinary (product-service)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_PRODUCT_FOLDER=ecommerce/products

# VNPay Sandbox (payment-service)
VNPAY_TMN_CODE=your_tmn_code
VNPAY_SECRET_KEY=your_secret_key
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8000/api/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:8000/api/payment/vnpay/ipn
FRONTEND_BASE_URL=http://localhost:3001
ORDER_SERVICE_BASE_URL=http://localhost:8086

# Keycloak service account used by user-service.
# The default local realm import uses local-demo-client-secret, so this is optional for local demo.
KEYCLOAK_CLIENT_SECRET=local-demo-client-secret
