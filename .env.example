# Local demo defaults only. Docker Compose reads .env; Spring JVMs require OS/IDE environment variables.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
DB_POOL_SIZE=20
DB_MIN_IDLE=2
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=password
# EUREKA_URL=http://eureka:password@localhost:8761/eureka/
KEYCLOAK_SERVER_URL=http://localhost:8085
KEYCLOAK_REALM=spring-boot-microservices-realm
KEYCLOAK_CLIENT_ID=spring-cloud-client
# Use the existing client's actual Credentials secret for an already initialized realm.
KEYCLOAK_CLIENT_SECRET=local-demo-client-secret
KEYCLOAK_DB_ROOT_PASSWORD=root
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
REDIS_HOST=localhost
REDIS_PORT=6379
PRODUCT_SERVICE_BASE_URL=http://localhost:8083
INVENTORY_SERVICE_BASE_URL=http://localhost:8082
ORDER_SERVICE_BASE_URL=http://localhost:8086
FRONTEND_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=admin
SEED_ADMIN_ENABLED=true
SEED_ADMIN_PASSWORD=admin123456@
SEED_PRODUCTS_ENABLED=true
PRODUCT_SEED_INITIAL_STOCK=10000
# Opt-in migration adoption: see docs/batch1-finalization.md before enabling.
# SPRING_PROFILES_ACTIVE=migrations
# FLYWAY_BASELINE_ON_MIGRATE=true
# JPA_DDL_AUTO=validate
# Per-service ports can be overridden with API_GATEWAY_PORT, DISCOVERY_SERVER_PORT, etc.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=ecommerce/products
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8000/api/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:8000/api/payment/vnpay/ipn
